//creating my sketch window for project
void setup () {
  size(550,450);
  background(255);

}
//creating pattern A with vertical stripes
void draw() {
  fill(255,77,225);
  rect(180,100,180,180);
  fill(0,0,0);
  line(200,100,200,280);
  line(220,100,220,280);
  line(240,100,240,280);
  line(260,100,260,280);
  line(280,100,280,280);
  line(300,100,300,280);
  line(320,100,320,280);
  line(340,100,340,280);
}
