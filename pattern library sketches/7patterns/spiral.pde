//creating my sketch window for project
void setup () {
  size(550, 450);
  background(255);
}
//creating pattern f - spiral
void draw() {
  fill(255, 0, 0);
  rect(180, 100, 180, 180);
  noFill();
  //centre spiral
  arc(270, 190, 60, 60, 5.2, 7.4);
  arc(270, 190, 45, 45, 4.0, 6.2);
  arc(270, 190, 30, 30, 2.8, 5.0);
  arc(270, 190, 15, 15, 1.6, 3.8);
  arc(270,190,8,8,1.8,4.4);
  //spiral2
  arc(330, 145, 60, 60, 5.2, 7.4);
  arc(330, 140, 45, 45, 4.0, 6.2);
  arc(330, 140, 30, 30, 2.8, 5.0);
  arc(330, 140, 15, 15, 1.6, 3.8);
  //spiral3
  arc(225, 245, 60, 60, 5.2, 7.4);
  arc(225, 245, 45, 45, 4.0, 6.2);
  arc(225, 245, 30, 30, 2.8, 5.0);
  arc(225, 245, 15, 15, 1.6, 3.8);
  arc(225,245,8,8,1.8,4.4);
  //spiral4
  arc(220, 140, 40, 40, 5.2, 7.4);
  arc(220, 140, 30, 30, 4.0, 6.2);
  arc(220, 140, 20, 20, 2.8, 5.0);
  arc(220, 140, 10, 10, 1.6, 3.8);
  arc(220,140,8,8,1.8,4.4);
  //spiral5
  arc(325, 245, 40, 40, 5.2, 7.4);
  arc(325, 245, 30, 30, 4.0, 6.2);
  arc(325, 245, 20, 20, 2.8, 5.0);
  arc(325, 245, 10, 10, 1.6, 3.8);
}
