//creating my sketch window for project
void setup () {
  size(550, 450);
  background(255);
}
//creating pattern g - plaid
void draw() {
  fill(131, 60, 12);
  strokeWeight(3);
  rect(180, 100, 180, 180);
  noFill();
  strokeWeight(4);
  line(200, 100, 200, 280);
  line(220, 100, 220, 280);
  line(240, 100, 240, 280);
  line(260, 100, 260, 280);
  line(280, 100, 280, 280);
  line(300, 100, 300, 280);
  line(320, 100, 320, 280);
  line(340, 100, 340, 280);
  noFill();
  strokeWeight(1);
  line(190, 100, 190, 280);
  line(210, 100, 210, 280);
  line(230, 100, 230, 280);
  line(250, 100, 250, 280);
  line(270, 100, 270, 280);
  line(290, 100, 290, 280);
  line(310, 100, 310, 280);
  line(330, 100, 330, 280);
  line(350, 100, 350, 280);
  noFill();
  strokeWeight(4);
  line(180,125,360,125);
  line(180,150,360,150);
  line(180,175,360,175);
  line(180,200,360,200);
  line(180,225,360,225);
  line(180,250,360,250);
  noFill();
  strokeWeight(1);
  line(180,120,360,120);
  line(180,145,360,145);
  line(180,170,360,170);
  line(180,195,360,195);
  line(180,220,360,220);
  line(180,245,360,245);
}
